    "test": "node test/engine.test.mjs && node test/docs.test.mjs"
  },
  "dependencies": {
    "sibujs": "^4.14.1"
  },
  "devDependencies": {
    "sibujs-cli": "^1.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
